                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.datos && body.datos.token) {",
                  "  pm.collectionVariables.set('adminToken', body.datos.token);",
                  "  pm.collectionVariables.set('token', body.datos.token);",
                  "}"
